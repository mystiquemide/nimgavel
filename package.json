{
  "name": "nimgavel",
  "version": "0.1.0",
  "private": true,
  "description": "Live community auction house for Nimiq Pay. Going once. Going twice. NIM.",
  "type": "module",
  "scripts": {
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nimgavel --local",
    "db:migrate:remote": "wrangler d1 migrations apply nimgavel --remote",
    "test": "node --test test/*.test.js",
    "soak": "node scripts/stress-soak.mjs",
    "worker:check": "wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mystiquemide/nimgavel.git"
  },
  "homepage": "https://nimgavel.artistic-chip.workers.dev",
  "dependencies": {
    "@nimiq/core": "^2.7.1",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "wrangler": "^4.40.0"
  }
}
